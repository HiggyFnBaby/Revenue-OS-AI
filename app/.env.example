# Copy this file to .env and fill in real values. Nothing here is optional
# for the app to actually run end to end — but you can get it compiling and
# the UI loading before every value is real.

# --- Database ---
# A real Postgres connection string. Free options: Supabase, Neon, Railway.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# DATABASE_URL is what the running app uses. On a serverless host (Vercel)
# every request can open its own connection, so point this at your provider's
# *pooled* endpoint or you will exhaust Postgres connection limits under load.
# On Supabase that is the Transaction pooler (port 6543); append
# ?pgbouncer=true&connection_limit=1 to the string it gives you.
DATABASE_URL="postgresql://user:password@localhost:5432/revenue_os"

# DIRECT_URL is the *unpooled* connection (port 5432), used only by
# `npm run db:push` / `db:migrate`. Migrations take advisory locks and run DDL,
# which a transaction pooler cannot carry — so they need a real session.
# Running locally against a plain Postgres with no pooler? Set both to the
# same value; the CLI falls back to DATABASE_URL when DIRECT_URL is unset.
#
# Since Prisma 7 these URLs live outside schema.prisma: the running app reads
# DATABASE_URL through the driver adapter in src/lib/prisma.ts, and the CLI
# reads DIRECT_URL from prisma.config.ts. Vercel never runs migrations, so the
# deployment only needs DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/revenue_os"

# --- Auth ---
# NEXTAUTH_SECRET: any long random string, used to encrypt session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The URL this app is running at. http://localhost:3000 for local dev.
# Also used as the base of the link in password reset emails, so in
# production it must be the real public address (e.g. https://app.example.com).
NEXTAUTH_URL="http://localhost:3000"

# --- Email (password reset links) ---
# Sent through Resend (https://resend.com): create an API key and verify the
# sending domain, then set both values. EMAIL_FROM must be on that domain.
# In development you can leave these blank — the reset link is printed to the
# server log instead. In production both are required or "forgot password"
# returns an error.
RESEND_API_KEY=""
EMAIL_FROM="Revenue OS <no-reply@example.com>"

# --- Claude API (powers the "Run agent" button on a lead) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Optional override; defaults to claude-opus-5 if unset. Must be a current
# model (Claude 4.6 or later) — the app sends adaptive thinking and the
# server-side fallback chain, which older models reject. claude-sonnet-5 is
# the cheaper option at the same API surface.
ANTHROPIC_MODEL="claude-opus-5"
# Optional. Trades depth for speed and cost: low | medium | high | xhigh | max.
# Unset means the API default (high). "medium" is the usual step down.
ANTHROPIC_EFFORT=""
# Per-workspace ceiling on "Run agent" calls. Each run is a paid Anthropic API
# call and a trial needs no card, so this is what stops one workspace from
# spending the month's API budget. Both are optional; these are the defaults.
AGENT_RUNS_PER_HOUR="20"
AGENT_RUNS_PER_DAY="100"

# --- Marketing page ---
# Just display text on the homepage pricing card — set this to match the
# actual amount on your STRIPE_PRICE_ID below; it's not read by Stripe itself.
NEXT_PUBLIC_PRICE_LABEL="$49/month"

# --- Legal pages (/terms and /privacy) ---
# All optional; see src/lib/legal.ts for the fallbacks. Set these before
# taking payments so the pages name the real contracting party.
# The registered legal entity that appears as the contracting party.
NEXT_PUBLIC_COMPANY_NAME="Revenue OS"
# Where privacy requests and legal notices go. Falls back to the EMAIL_FROM
# address, then to support@<your app's domain>.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=""
# Jurisdiction whose law governs the terms, e.g. "the State of Georgia, United States".
NEXT_PUBLIC_GOVERNING_LAW="the United States"

# --- Billing ---
# Which payment processor to use. Only "stripe" is implemented so far —
# see src/lib/billing/index.ts for how to add Paddle/LemonSqueezy later.
BILLING_PROVIDER="stripe"
# From https://dashboard.stripe.com/apikeys (use a test key while building)
STRIPE_SECRET_KEY=""
# The recurring Price you create in the Stripe Dashboard for this product's
# subscription (Product catalog > your product > pricing).
STRIPE_PRICE_ID=""
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/billing/webhook`)
# or from the webhook endpoint you configure in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=""
# No variable needed for the "Manage billing" button — it uses Stripe's hosted
# Customer Portal. In LIVE mode, save the portal settings once in the Stripe
# Dashboard (Settings > Billing > Customer portal) or the button will error
# with "No configuration provided". Test mode has a default configuration.
